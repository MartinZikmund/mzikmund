{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [ "ES2020", "DOM", "DOM.Iterable" ],
		"strict": true,
		"noImplicitAny": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"useDefineForClassFields": true,
		"allowJs": false,
		"types": []
	},
	"include": [ "Scripts/**/*.ts" ],
	"exclude": [ "node_modules", "wwwroot" ]
}
