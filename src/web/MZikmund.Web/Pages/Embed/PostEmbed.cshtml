@page "/embed/post/{id:guid}"
@using MZikmund.DataContracts.Blog
@model MZikmund.Web.Pages.Embed.PostEmbedModel

@{
	Layout = null;
}

@*
	Standalone embed document: no site chrome, no layout. Like _Layout it renders
	no theme attribute on <html> — site.js writes it render-blocking from the
	stored preference, and without JS the prefers-color-scheme fallback applies.
	Hard-coding a light theme here forced dark-mode hosts to embed a light card.
*@
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="robots" content="noindex, nofollow" />
	<title>@Model.BlogPost?.Title</title>

	@* Same font preload and dev/prod stylesheet switch as _HeadStylesPartial. *@
	<link rel="preload" href="~/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

	<environment names="Development">
		<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	</environment>
	<environment names="Staging,Production">
		<link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
	</environment>

	@* Blocking in <head>: applies the stored colour theme before first paint. *@
	<script src="~/js/site.js" asp-append-version="true"></script>
</head>
<body>
	<partial name="_IconSprite" />

	@* Mirrors _PostHero: banner image, then the title on a solid surface. *@
	<div class="post-hero">
		@if (Model.SafeHeroImageUrl is not null)
		{
			<div class="post-hero__banner">
				<img class="post-hero__image" src="@Model.SafeHeroImageUrl" alt="@(Model.BlogPost?.HeroImageAlt ?? string.Empty)" />
			</div>
		}
		<div class="post-hero__body">
			<div class="container">
				<div class="post-hero__inner">
					@if (Model.BlogPost!.Categories.Length > 0)
					{
						<div class="post-hero__categories">
							@foreach (var category in Model.BlogPost.Categories)
							{
								<a class="badge badge--subtle" asp-page="/Blog/CategoryPostList" asp-route-categoryName="@category.RouteName">@category.DisplayName</a>
							}
						</div>
					}
					<h1 class="post-hero__title">@Model.BlogPost.Title</h1>
					<div class="post-hero__meta">
						<span class="meta__item">
							<svg class="icon" aria-hidden="true"><use href="#i-calendar3"></use></svg>
							@Model.BlogPost.PublishedDate.Humanize()
						</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<main role="main" class="site-main">
		<div class="container">
			<div class="article-layout">
				<div class="article-layout__main">
					<article class="blog-post">
						<div class="post-content prose">
							@Html.Raw(Model.HtmlContent)
						</div>
					</article>
				</div>
			</div>
		</div>
	</main>
</body>
</html>
