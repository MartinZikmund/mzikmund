@model MZikmund.Web.Pages.Blog.IPostPageModel
@using System.Linq

<article class="blog-post">
    <div class="post-content prose">
        @Html.Raw(Model.HtmlContent)
    </div>

    <footer class="post-footer">
        <div class="post-ad">
            <!-- ArticleBottom -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-7501232789626725"
                 data-ad-slot="4418669923"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
            <script>
                 (adsbygoogle = window.adsbygoogle || []).push({});
            </script>
        </div>

        @if (Model.BlogPost!.Tags.Length > 0)
        {
            <div class="post-tags">
                @foreach (var tag in Model.BlogPost!.Tags)
                {
                    <a class="tag" asp-page="/Blog/TagPostList" asp-route-tagName="@tag.RouteName">#@tag.DisplayName</a>
                }
            </div>
        }

        <div class="author-bio">
            <img src="~/img/logo.png" alt="Martin Zikmund" width="64" height="64" />
            <div>
                <p class="author-bio__name">Martin Zikmund</p>
                <p class="author-bio__text">Open-source developer, speaker, and .NET enthusiast building cross-platform apps with Uno Platform.</p>
            </div>
        </div>

        <div>
            <a asp-page="/Blog/Index" class="btn btn--subtle btn--sm">
                <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>Back to Blog
            </a>
        </div>
    </footer>
</article>
