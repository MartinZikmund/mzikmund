@page
@model MZikmund.Web.Pages.Blog.IndexModel
@{
    <div class="page-header">
        <h1 class="page-header__title">@Localizer["Blog"]</h1>
        <p class="page-header__lead">@Localizer["Thoughts, ideas, and tutorials on software development"]</p>
        <div class="page-header__actions">
            <a asp-page="/Blog/CategoryList" class="btn btn--standard">
                <svg class="icon" aria-hidden="true"><use href="#i-folder2-open"></use></svg>
                Browse by Category
            </a>
            <a asp-page="/Blog/TagList" class="btn btn--standard">
                <svg class="icon" aria-hidden="true"><use href="#i-tag"></use></svg>
                Browse by Tag
            </a>
        </div>
    </div>

    @* _PostList supplies its own .card-grid — wrapping it in another one nests
       a grid inside a grid and turns the pagination nav into a card column. *@
    <partial name="_PostList" model="Model.BlogPosts" />
}
