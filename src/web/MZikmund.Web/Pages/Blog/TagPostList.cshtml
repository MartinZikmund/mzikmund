@page "/Blog/Tags/{tagName}"
@model MZikmund.Web.Pages.Blog.TagPostListModel

@{
    MetaTags.Title = Model.Tag.DisplayName;
}

@{
    <div class="page-header">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb__item">
                    <a class="breadcrumb__link" asp-page="/Blog/Index">Blog</a>
                    <svg class="icon breadcrumb__separator" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </li>
                <li class="breadcrumb__item">
                    <a class="breadcrumb__link" asp-page="/Blog/TagList">Tags</a>
                    <svg class="icon breadcrumb__separator" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </li>
                <li class="breadcrumb__item">
                    <span class="breadcrumb__current" aria-current="page">#@Model.Tag.DisplayName</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-header__title">#@Model.Tag.DisplayName</h1>
        @if (!string.IsNullOrEmpty(Model.Tag.Description))
        {
            <p class="page-header__lead">@Model.Tag.Description</p>
        }
    </div>

    @* _PostList supplies its own .card-grid. *@
    <partial name="_PostList" model="Model.BlogPosts" />
}
