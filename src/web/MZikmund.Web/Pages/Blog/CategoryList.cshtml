@page "/Blog/Categories"
@model MZikmund.Web.Pages.Blog.CategoryListModel;

@{
    MetaTags.Title = "Blog Categories";
}

<div class="page-header">
    <h1 class="page-header__title">Blog Categories</h1>
    <p class="page-header__lead">Browse posts by category</p>
    <div class="page-header__actions">
        <a asp-page="/Blog/Index" class="btn btn--standard">
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>
            Back to Blog
        </a>
    </div>
</div>

<div class="card-grid">
    @foreach (var category in Model.Categories)
    {
        <a class="taxonomy-card" asp-page="/Blog/CategoryPostList" asp-route-categoryName="@category.RouteName">
            <span class="taxonomy-card__title">
                <svg class="icon" aria-hidden="true"><use href="#i-folder2-open"></use></svg>
                @category.DisplayName
            </span>
            @if (!string.IsNullOrEmpty(category.Description))
            {
                <span class="text-secondary">@category.Description</span>
            }
            <span class="taxonomy-card__count">
                @category.PostCount @(category.PostCount == 1 ? "post" : "posts")
            </span>
        </a>
    }
</div>
