@page "/Blog/Categories"
@model MZikmund.Web.Pages.Blog.CategoryListModel;

@{
    MetaTags.Title = "Blog Categories";
}

<div class="page-header">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb__item">
                <a class="breadcrumb__link" asp-page="/Blog/Index">Blog</a>
                <svg class="icon breadcrumb__separator" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
            </li>
            <li class="breadcrumb__item">
                <span class="breadcrumb__current" aria-current="page">Categories</span>
            </li>
        </ol>
    </nav>
    <h1 class="page-header__title">Blog Categories</h1>
    <p class="page-header__lead">Browse posts by category</p>
</div>

@* Compact navigation rows rather than content cards — see .taxonomy-list. *@
<nav class="taxonomy-list" aria-label="Categories">
    @foreach (var category in Model.Categories)
    {
        <a class="taxonomy-row" asp-page="/Blog/CategoryPostList" asp-route-categoryName="@category.RouteName"
           title="@(string.IsNullOrWhiteSpace(category.Description) ? null : category.Description)">
            <svg class="icon" aria-hidden="true"><use href="#i-folder2-open"></use></svg>
            <span class="taxonomy-row__name">@category.DisplayName</span>
            @* The visible count is a bare number so the column stays scannable;
               the unit lives in the accessible name instead. *@
            <span class="taxonomy-row__count" aria-label="@category.PostCount @(category.PostCount == 1 ? "post" : "posts")">
                @category.PostCount
            </span>
        </a>
    }
</nav>
