@page "/Blog/Tags"
@model MZikmund.Web.Pages.Blog.TagListModel;

@{
    MetaTags.Title = "Blog Tags";
}

<div class="page-header">
    <h1 class="page-header__title">Blog Tags</h1>
    <p class="page-header__lead">Browse posts by tag</p>
    <div class="page-header__actions">
        <a asp-page="/Blog/Index" class="btn btn--standard">
            <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>
            Back to Blog
        </a>
    </div>
</div>

<div class="card-grid">
    @foreach (var tag in Model.Tags)
    {
        <a class="taxonomy-card" asp-page="/Blog/TagPostList" asp-route-tagName="@tag.RouteName">
            <span class="taxonomy-card__title">
                <svg class="icon" aria-hidden="true"><use href="#i-tag"></use></svg>
                #@tag.DisplayName
            </span>
            @if (!string.IsNullOrEmpty(tag.Description))
            {
                <span class="text-secondary">@tag.Description</span>
            }
            <span class="taxonomy-card__count">
                @tag.PostCount @(tag.PostCount == 1 ? "post" : "posts")
            </span>
        </a>
    }
</div>
