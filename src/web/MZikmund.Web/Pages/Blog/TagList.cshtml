@page "/Blog/Tags"
@model MZikmund.Web.Pages.Blog.TagListModel;

@{
    MetaTags.Title = "Blog Tags";
}

<div class="page-header">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb__item">
                <a class="breadcrumb__link" asp-page="/Blog/Index">Blog</a>
                <svg class="icon breadcrumb__separator" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
            </li>
            <li class="breadcrumb__item">
                <span class="breadcrumb__current" aria-current="page">Tags</span>
            </li>
        </ol>
    </nav>
    <h1 class="page-header__title">Blog Tags</h1>
    <p class="page-header__lead">Browse posts by tag</p>
</div>

@* ~500 tags, so anything taller than a pill makes this page unusable. *@
<nav class="tag-cloud" aria-label="Tags">
    @foreach (var tag in Model.Tags)
    {
        <a class="tag @(tag.PostCount == 0 ? "tag--empty" : "")" asp-page="/Blog/TagPostList" asp-route-tagName="@tag.RouteName"
           title="@(string.IsNullOrWhiteSpace(tag.Description) ? null : tag.Description)">
            #@tag.DisplayName
            <span class="tag__count" aria-label="@tag.PostCount @(tag.PostCount == 1 ? "post" : "posts")">@tag.PostCount</span>
        </a>
    }
</nav>
