@page "/Blog/Categories/{categoryName}"
@model MZikmund.Web.Pages.Blog.CategoryPostListModel

@{
    MetaTags.Title = Model.Category.DisplayName;
}

@{
    <div class="page-header">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb__item">
                    <a class="breadcrumb__link" asp-page="/Blog/Index">Blog</a>
                    <svg class="icon breadcrumb__separator" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </li>
                <li class="breadcrumb__item">
                    <a class="breadcrumb__link" asp-page="/Blog/CategoryList">Categories</a>
                    <svg class="icon breadcrumb__separator" aria-hidden="true"><use href="#i-chevron-right"></use></svg>
                </li>
                <li class="breadcrumb__item">
                    <span class="breadcrumb__current" aria-current="page">@Model.Category.DisplayName</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-header__title">@Model.Category.DisplayName</h1>
        @if (!string.IsNullOrEmpty(Model.Category.Description))
        {
            <p class="page-header__lead">@Model.Category.Description</p>
        }
    </div>

    @* _PostList supplies its own .card-grid. *@
    <partial name="_PostList" model="Model.BlogPosts" />
}
