@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@section AboveMain
{
    <section class="hero">
        <div class="container">
            <div class="hero__inner">
                <p class="hero__eyebrow">Open-source developer &amp; speaker</p>
                <h1 class="hero__title">Martin Zikmund</h1>
                <div class="hero__rule"></div>
                <p class="hero__lead">I build cross-platform apps with .NET and Uno Platform, contribute to open source, and share what I learn along the way.</p>
                <div class="hero__actions">
                    <a asp-page="/Blog/Index" class="btn btn--accent btn--lg">Read the Blog</a>
                    <a href="https://github.com/MartinZikmund" target="_blank" rel="noopener" class="btn btn--standard btn--lg">
                        <svg class="icon" aria-hidden="true"><use href="#i-github"></use></svg>GitHub
                    </a>
                </div>
                <p class="hero__topics">
                    <span>.NET</span>
                    <span class="hero__topic-sep" aria-hidden="true">·</span>
                    <span>Uno Platform</span>
                    <span class="hero__topic-sep" aria-hidden="true">·</span>
                    <span>WinUI</span>
                    <span class="hero__topic-sep" aria-hidden="true">·</span>
                    <span>C#</span>
                </p>
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="section-head">
        <div class="section-head__text">
            <h2 class="section-head__title">Latest Posts</h2>
            <p class="section-head__subtitle">Thoughts on .NET, Uno Platform, and open source</p>
        </div>
        <a asp-page="/Blog/Index" class="btn btn--standard">
            View all posts<span class="btn__arrow">&rarr;</span>
        </a>
    </div>
    <div class="card-grid">
        @foreach (var post in Model.BlogPosts)
        {
            <partial name="_PostListItem" model="post" />
        }
    </div>
</section>

@if (Model.FeaturedVideos?.Count > 0)
{
    <section class="section">
        <div class="section-head">
            <div class="section-head__text">
                <h2 class="section-head__title">Latest Videos</h2>
                <p class="section-head__subtitle">Check out my latest video content on YouTube</p>
            </div>
            <a asp-page="/Videos" class="btn btn--standard">
                View all videos<span class="btn__arrow">→</span>
            </a>
        </div>
        <div class="card-grid">
            @foreach (var video in Model.FeaturedVideos)
            {
                <partial name="Shared/_VideoListItem" model="video" />
            }
        </div>
    </section>
}
