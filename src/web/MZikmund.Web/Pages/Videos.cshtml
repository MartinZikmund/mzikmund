@page
@model VideosModel
@{
	ViewData["Title"] = "Videos";
}

<div class="page-header">
	<h1 class="page-header__title">@ViewData["Title"]</h1>
	<p class="page-header__lead">Latest videos from my YouTube channel covering .NET, C#, and web development.</p>
	<div class="page-header__actions">
		<a href="@Model.YouTubeChannelUrl" target="_blank" rel="noopener" class="btn btn--standard">
			<svg class="icon" aria-hidden="true"><use href="#i-youtube"></use></svg>Subscribe on YouTube
		</a>
	</div>
</div>

@if (Model.Videos is null)
{
	<div class="empty-state" role="alert">
		<svg class="icon" aria-hidden="true"><use href="#i-youtube"></use></svg>
		<h2 class="text-body-large">Videos temporarily unavailable</h2>
		<p>We're having trouble loading videos right now. Please try again later, or visit the channel directly:</p>
		<a href="@Model.YouTubeChannelUrl" target="_blank" rel="noopener" class="btn btn--standard">
			Visit my YouTube channel
		</a>
	</div>
}
else if (Model.Videos.Count > 0)
{
	<div class="card-grid">
		@foreach (var video in Model.Videos)
		{
			<partial name="Shared/_VideoListItem" model="video" />
		}
	</div>
}
else
{
	<div class="empty-state">
		<svg class="icon" aria-hidden="true"><use href="#i-inbox"></use></svg>
		<h2 class="text-body-large">No videos available yet</h2>
		<p>Check back soon for new content! In the meantime, you can:</p>
		<a href="@Model.YouTubeChannelUrl" target="_blank" rel="noopener" class="btn btn--standard">
			Visit my YouTube channel
		</a>
	</div>
}

<hr />

<footer class="text-center text-secondary text-caption">
	<p>Videos powered by <a href="https://www.youtube.com" target="_blank" rel="noopener">YouTube</a></p>
</footer>
