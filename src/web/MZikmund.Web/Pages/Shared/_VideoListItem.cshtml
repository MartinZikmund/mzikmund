@model MZikmund.DataContracts.Videos.VideoDto

<article class="card">
	<div class="card__media">
		<img class="card__image"
			 src="@Model.ThumbnailUrl"
			 alt=""
			 loading="lazy">
		<div class="card__play">
			<svg class="icon" aria-hidden="true"><use href="#i-play-circle"></use></svg>
		</div>
	</div>
	<div class="card__body">
		<div class="meta">
			<span class="meta__item">
				<svg class="icon" aria-hidden="true"><use href="#i-calendar3"></use></svg>
				@Model.PublishedDate.ToString("MMM d, yyyy")
			</span>
		</div>
		<h3 class="card__title">
			<a class="card__link" href="@Model.YouTubeUrl" target="_blank" rel="noopener"
			   aria-label="Watch video on YouTube: @Model.Title">@Model.Title</a>
		</h3>
		<p class="card__excerpt">@Model.Description</p>
		<div class="card__footer">
			<span class="btn btn--sm btn--accent-subtle">
				<svg class="icon" aria-hidden="true"><use href="#i-play-fill"></use></svg>
				Watch on YouTube
				<span class="btn__arrow">→</span>
			</span>
		</div>
	</div>
</article>
