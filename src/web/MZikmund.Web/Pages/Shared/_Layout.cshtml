@using System.Runtime.InteropServices
@using MZikmund.Web.Core.Services
@inject IVersionInfoProvider VersionInfo
@*
	No data-theme is rendered on <html>. site.js sets it render-blocking in
	<head> from the stored preference; without JS the CSS falls back to
	prefers-color-scheme. Hard-coding "light" here (as before) forced a flash of
	light for dark-mode visitors and defeated the media-query fallback.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <title>@MetaTags.HtmlTitle</title>

    <partial name="_HeadMetaPartial" />
    <partial name="_HeadLinksPartial" />

    <partial name="_HeadStylesPartial" />

    @{
        var jsSnippet = Context.RequestServices.GetService<Microsoft.ApplicationInsights.AspNetCore.JavaScriptSnippet>();
    }
    @if (jsSnippet != null)
    {
        @Html.Raw(jsSnippet.FullScript)
    }
    <partial name="_HeadScriptsPartial" />

    @await RenderSectionAsync(LayoutSections.Head, required: false)
</head>
<body>
    <partial name="_IconSprite" />

    <a class="skip-link" href="#main">Skip to content</a>

    @* Without JS the toggle cannot open the menu, so show it and hide the toggle. *@
    <noscript>
        <style>
            #site-nav[hidden] { display: flex; }
            .site-header__toggle { display: none !important; }
        </style>
    </noscript>

    @{
        var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? "";
        bool isHome = currentPath == "" || currentPath == "/";
        bool isBlog = currentPath.StartsWith("/Blog", StringComparison.OrdinalIgnoreCase);
        bool isVideos = currentPath.StartsWith("/Videos", StringComparison.OrdinalIgnoreCase);
        bool isContact = currentPath.StartsWith("/Contact", StringComparison.OrdinalIgnoreCase);
    }
    <header class="site-header">
        <div class="container site-header__inner">
            <button class="site-header__toggle" type="button" data-nav-toggle
                    aria-expanded="false" aria-controls="site-nav" aria-label="@Localizer["Menu"]">
                <svg class="icon icon--lg" aria-hidden="true"><use href="#i-list"></use></svg>
            </button>

            <a class="site-brand" asp-area="" asp-page="/Index" aria-label="Martin Zikmund — home">
                <img src="~/img/logo.png" width="36" height="36" alt="" />
            </a>

            @*
                Ships `hidden` so the mobile menu does not flash open before
                SiteNav runs. Above 48rem the stylesheet overrides it back to
                flex, so this only affects the collapsed layout. The <noscript>
                below restores it when there is no JS to open it.
            *@
            <ul class="site-nav" id="site-nav" hidden>
                <li>
                    <a class="site-nav__link" asp-page="/Index" aria-current="@(isHome ? "page" : null)">@Localizer["Home"]</a>
                </li>
                <li>
                    <a class="site-nav__link" asp-page="/Blog/Index" aria-current="@(isBlog ? "page" : null)">@Localizer["Blog"]</a>
                </li>
                <li>
                    <a class="site-nav__link" asp-page="/Videos" aria-current="@(isVideos ? "page" : null)">@Localizer["Videos"]</a>
                </li>
                <li>
                    <a class="site-nav__link" asp-page="/Contact" aria-current="@(isContact ? "page" : null)">@Localizer["Contact"]</a>
                </li>
            </ul>

            <div class="site-header__actions">
                <div class="theme-menu" id="theme-dropdown">
                    <button class="theme-menu__trigger" type="button" data-theme-trigger
                            aria-expanded="false" aria-haspopup="true" aria-label="@Localizer["Theme"]" title="@Localizer["Theme"]">
                        <svg class="icon icon--lg" id="theme-icon" aria-hidden="true"><use href="#i-circle-half"></use></svg>
                    </button>
                    @*
                        popover puts the menu in the top layer, which escapes the
                        header's backdrop-filter context — that is what lets it be
                        real Acrylic (a nested backdrop-filter samples its filtered
                        ancestor, not the page). It also supplies light-dismiss and
                        Escape for free.
                    *@
                    <ul class="theme-menu__list" data-theme-menu popover="auto" id="theme-menu"
                        role="menu" aria-label="@Localizer["Theme"]">
                        <li role="none">
                            <a class="theme-menu__item" role="menuitemradio" aria-checked="true" data-value="auto" href="#">
                                <svg class="icon" aria-hidden="true"><use href="#i-circle-half"></use></svg>@Localizer["Auto"]
                            </a>
                        </li>
                        <li role="none">
                            <a class="theme-menu__item" role="menuitemradio" aria-checked="false" data-value="light" href="#">
                                <svg class="icon" aria-hidden="true"><use href="#i-sun"></use></svg>@Localizer["Light"]
                            </a>
                        </li>
                        <li role="none">
                            <a class="theme-menu__item" role="menuitemradio" aria-checked="false" data-value="dark" href="#">
                                <svg class="icon" aria-hidden="true"><use href="#i-moon-stars"></use></svg>@Localizer["Dark"]
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    @* Rendered outside .container so heroes can be full-bleed. *@
    @await RenderSectionAsync(LayoutSections.AboveMain, false)

    <main role="main" class="site-main" id="main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer__main">
                <a href="/" class="site-footer__brand">
                    <img src="~/img/logo.png" width="28" height="28" alt="" />
                    <span>© @DateTimeOffset.UtcNow.Year Martin Zikmund</span>
                </a>

                <ul class="site-footer__social">
                    <li>
                        <a href="https://github.com/MartinZikmund/" class="site-footer__social-link" title="GitHub" aria-label="GitHub" target="_blank" rel="noopener">
                            <svg class="icon" aria-hidden="true"><use href="#i-github"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a href="https://x.com/mzikmunddev/" class="site-footer__social-link" title="X" aria-label="X" target="_blank" rel="noopener">
                            <svg class="icon" aria-hidden="true"><use href="#i-twitter-x"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.youtube.com/@@mzikmund" class="site-footer__social-link" title="YouTube" aria-label="YouTube" target="_blank" rel="noopener">
                            <svg class="icon" aria-hidden="true"><use href="#i-youtube"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a href="https://facebook.com/mzikmunddev/" class="site-footer__social-link" title="Facebook" aria-label="Facebook" target="_blank" rel="noopener">
                            <svg class="icon" aria-hidden="true"><use href="#i-facebook"></use></svg>
                        </a>
                    </li>
                    <li>
                        <a href="https://github.com/MartinZikmund/mzikmund" class="site-footer__social-link" title="Contribute" aria-label="Contribute to this site" target="_blank" rel="noopener">
                            <svg class="icon" aria-hidden="true"><use href="#i-code-slash"></use></svg>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="site-footer__meta">
                <span>Proudly running @RuntimeInformation.FrameworkDescription</span>
                @if (!string.IsNullOrEmpty(VersionInfo.CommitUrl))
                {
                    var shortSha = VersionInfo.CommitSha?.Length >= 7 ? VersionInfo.CommitSha.Substring(0, 7) : VersionInfo.CommitSha;
                    <a href="@VersionInfo.CommitUrl" target="_blank" rel="noopener">@VersionInfo.Version+@shortSha</a>
                }
            </div>
        </div>
    </footer>

    @await RenderSectionAsync(LayoutSections.BodyEnd, required: false)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
