<local:MediaBrowserViewBase
    x:Class="MZikmund.Views.Admin.MediaBrowserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:items="using:MZikmund.ViewModels.Items"
    xmlns:local="using:MZikmund.Views.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:MZikmund.Extensions.Xaml"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="{StaticResource MzPagePaddingCompact}">
            <StackPanel Style="{StaticResource MzPageContainerStackStyle}">
                <Grid Margin="0,0,0,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PageTitle"
                        Style="{StaticResource MzTitleTextStyle}"
                        Text="{x:Bind ViewModel.Title}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="MediaUpload"
                        Command="{x:Bind ViewModel.UploadFileCommand}"
                        Style="{StaticResource MzAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource MzIconFontFamily}"
                                FontSize="16"
                                Glyph="{StaticResource MzGlyphArrowUpload}" />
                            <TextBlock Text="{xaml:Localize Key=Upload}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="480" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.AutomationId="MediaSearch"
                        AutomationProperties.Name="{xaml:Localize Key=Search}"
                        PlaceholderText="{xaml:Localize Key=Search}"
                        Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="150"
                        AutomationProperties.AutomationId="MediaFilter"
                        SelectedIndex="{x:Bind ViewModel.FilterMode, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                        <ComboBoxItem Content="{xaml:Localize Key=AllFiles}" />
                        <ComboBoxItem Content="{xaml:Localize Key=Images}" />
                        <ComboBoxItem Content="{xaml:Localize Key=Files}" />
                    </ComboBox>
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.MediaFiles, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="16"
                            MinItemWidth="200"
                            MinRowSpacing="16" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:StorageItemInfoViewModel">
                                <Border Style="{StaticResource MzLayerSurfaceStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource MzBgSecondaryBrush}" CornerRadius="{StaticResource MzCardTopCornerRadius}">
                                            <Grid>
                                                <Image
                                                    Margin="8"
                                                    Stretch="Uniform"
                                                    Visibility="{x:Bind IsImage}">
                                                    <Image.Source>
                                                        <BitmapImage DecodePixelWidth="400" UriSource="{x:Bind Url}" />
                                                    </Image.Source>
                                                </Image>
                                                <FontIcon
                                                    FontFamily="{StaticResource MzIconFontFamily}"
                                                    FontSize="40"
                                                    Foreground="{ThemeResource MzTextTertiaryBrush}"
                                                    Glyph="{StaticResource MzGlyphDocumentPdf}"
                                                    Visibility="{x:Bind IsImage, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        <Grid
                                            Grid.Row="1"
                                            Padding="12,8,4,8"
                                            ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource MzRowTitleTextStyle}"
                                                    Text="{x:Bind FileName}"
                                                    ToolTipService.ToolTip="{x:Bind FileName}" />
                                                <TextBlock Style="{StaticResource MzMetaTextStyle}" Text="{x:Bind FormattedSize}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{xaml:Localize Key=MoreActions}"
                                                Style="{StaticResource MzSubtleButtonSmallStyle}"
                                                ToolTipService.ToolTip="{xaml:Localize Key=MoreActions}">
                                                <FontIcon
                                                    FontFamily="{StaticResource MzIconFontFamily}"
                                                    FontSize="16"
                                                    Glyph="{StaticResource MzGlyphMore}" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            Click="CopyUrl_Click"
                                                            Tag="{x:Bind Url}"
                                                            Text="{xaml:Localize Key=CopyUrl}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="{StaticResource MzIconFontFamily}" Glyph="{StaticResource MzGlyphCopy}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem
                                                            Click="ShowVariants_Click"
                                                            Tag="{x:Bind}"
                                                            Text="{xaml:Localize Key=ViewVariants}"
                                                            Visibility="{x:Bind IsImage}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="{StaticResource MzIconFontFamily}" Glyph="{StaticResource MzGlyphImageMultiple}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem
                                                            Click="DeleteFile_Click"
                                                            Tag="{x:Bind}"
                                                            Text="{xaml:Localize Key=Delete}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon FontFamily="{StaticResource MzIconFontFamily}" Glyph="{StaticResource MzGlyphDelete}" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="{xaml:Localize Key=LoadMore}"
                    IsEnabled="{x:Bind local:MediaBrowserView.Not(ViewModel.IsLoadingMore), Mode=OneWay}"
                    Style="{StaticResource MzStandardButtonStyle}"
                    Visibility="{x:Bind ViewModel.HasMoreItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Style="{StaticResource MzEmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="{StaticResource MzGlyphImageMultiple}" Style="{StaticResource MzEmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{xaml:Localize Key=NoFilesFound}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MzTypeScale">
                <VisualState x:Name="MzTypeScaleWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageTitle.Style" Value="{StaticResource MzTitleWideTextStyle}" />
                        <Setter Target="PageRoot.Padding" Value="{StaticResource MzPagePaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MzTypeScaleCompact" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:MediaBrowserViewBase>
