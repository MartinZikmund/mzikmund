<local:CommentsModeratorViewBase
    x:Class="MZikmund.Views.Admin.CommentsModeratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MZikmund.Views.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MZikmund.ViewModels.Admin"
    xmlns:xaml="using:MZikmund.Extensions.Xaml"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <local:CommentsModeratorViewBase.Resources>
        <DataTemplate x:Key="ModerationRowTemplate" x:DataType="vm:CommentReportItemViewModel">
            <Grid Padding="12,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MzRowTitleTextStyle}"
                            Text="{x:Bind DisplayName}" />
                        <ContentControl
                            VerticalAlignment="Center"
                            Content="{x:Bind ReportCountText}"
                            Style="{StaticResource MzBadgeAccentStyle}"
                            Visibility="{x:Bind IsReport, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ContentControl
                            VerticalAlignment="Center"
                            Content="{x:Bind StatusText}"
                            Style="{StaticResource MzBadgeNeutralStyle}"
                            Visibility="{x:Bind IsNotVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock
                        xaml:CommentText.Markdown="{x:Bind Content}"
                        MaxLines="3"
                        Style="{StaticResource MzBodyTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Style="{StaticResource MzMetaTextStyle}" Text="{x:Bind MetaText}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="ModeratorRowMore"
                    AutomationProperties.Name="{xaml:Localize Key=MoreActions}"
                    Click="RowMore_Click"
                    Style="{StaticResource MzSubtleButtonSmallStyle}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{xaml:Localize Key=MoreActions}">
                    <FontIcon
                        FontFamily="{StaticResource MzIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource MzGlyphMore}" />
                </Button>
            </Grid>
        </DataTemplate>
    </local:CommentsModeratorViewBase.Resources>

    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="{StaticResource MzPagePaddingCompact}">
            <StackPanel Style="{StaticResource MzPageContainerStackStyle}">
                <Grid Margin="0,0,0,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="PageTitle"
                            Style="{StaticResource MzTitleTextStyle}"
                            Text="{x:Bind ViewModel.Title}" />
                        <TextBlock Style="{StaticResource MzMetaTextStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="ModeratorRefresh"
                        AutomationProperties.Name="{xaml:Localize Key=Refresh}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="{xaml:Localize Key=Refresh}">
                        <FontIcon
                            FontFamily="{StaticResource MzIconFontFamily}"
                            FontSize="16"
                            Glyph="{StaticResource MzGlyphArrowClockwise}" />
                    </Button>
                </Grid>

                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource MzSectionHeadingTextStyle}"
                    Text="{xaml:Localize Key=ModeratorReportedHeader}" />
                <Border
                    Margin="0,0,0,32"
                    Style="{StaticResource MzLayerSurfaceStyle}"
                    Visibility="{x:Bind ViewModel.HasReports, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater
                        Margin="4"
                        ItemTemplate="{StaticResource ModerationRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Reports}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Border>
                <StackPanel
                    Margin="0,0,0,32"
                    Style="{StaticResource MzEmptyStatePanelStyle}"
                    Visibility="{x:Bind ViewModel.IsQueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="{StaticResource MzGlyphComment}" Style="{StaticResource MzEmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{xaml:Localize Key=ModeratorNothingToReview}" />
                </StackPanel>

                <TextBlock
                    Margin="0,0,0,12"
                    Style="{StaticResource MzSectionHeadingTextStyle}"
                    Text="{xaml:Localize Key=ModeratorNewestHeader}" />
                <Border Style="{StaticResource MzLayerSurfaceStyle}" Visibility="{x:Bind ViewModel.HasFeed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater
                        Margin="4"
                        ItemTemplate="{StaticResource ModerationRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Feed}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Border>

                <Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="ModeratorLoadMore"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="{xaml:Localize Key=LoadMore}"
                    Style="{StaticResource MzStandardButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressRing
                    Margin="0,32"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Style="{StaticResource MzEmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="{StaticResource MzGlyphWarning}" Style="{StaticResource MzEmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{xaml:Localize Key=CouldNotLoadData}" />
                    <TextBlock Style="{StaticResource MzEmptyStateBodyTextStyle}" Text="{xaml:Localize Key=AdminLoadErrorDescription}" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="{xaml:Localize Key=Retry}"
                        Style="{StaticResource MzStandardButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MzTypeScale">
                <VisualState x:Name="MzTypeScaleWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageTitle.Style" Value="{StaticResource MzTitleWideTextStyle}" />
                        <Setter Target="PageRoot.Padding" Value="{StaticResource MzPagePaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MzTypeScaleCompact" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:CommentsModeratorViewBase>
