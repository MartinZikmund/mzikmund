<local:PostsManagerViewBase
    x:Class="MZikmund.Views.Admin.PostsManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:MZikmund.DataContracts.Blog"
    xmlns:local="using:MZikmund.Views.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:MZikmund.Extensions.Xaml"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="{StaticResource MzPagePaddingCompact}">
            <StackPanel Style="{StaticResource MzPageContainerStackStyle}">
                <Grid Margin="0,0,0,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="PageTitle"
                            Style="{StaticResource MzTitleTextStyle}"
                            Text="{x:Bind ViewModel.Title}" />
                        <TextBlock Style="{StaticResource MzMetaTextStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="PostsAdd"
                        Command="{x:Bind ViewModel.AddPostCommand}"
                        Style="{StaticResource MzAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource MzIconFontFamily}"
                                FontSize="16"
                                Glyph="{StaticResource MzGlyphAdd}" />
                            <TextBlock Text="{xaml:Localize Key=NewPost}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,16" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="480" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.AutomationId="PostsSearch"
                        AutomationProperties.Name="{xaml:Localize Key=Search}"
                        PlaceholderText="{xaml:Localize Key=SearchPosts}"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="PostsRefresh"
                        AutomationProperties.Name="{xaml:Localize Key=Refresh}"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="{xaml:Localize Key=Refresh}">
                        <FontIcon
                            FontFamily="{StaticResource MzIconFontFamily}"
                            FontSize="16"
                            Glyph="{StaticResource MzGlyphArrowClockwise}" />
                    </Button>
                </Grid>

                <Border Style="{StaticResource MzLayerSurfaceStyle}" Visibility="{x:Bind ViewModel.HasVisiblePosts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsRepeater Margin="4" ItemsSource="{x:Bind ViewModel.VisiblePosts}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="dto:PostListItem">
                                <Button
                                    AutomationProperties.Name="{x:Bind Title}"
                                    Click="PostRow_Click"
                                    Style="{StaticResource MzListRowButtonStyle}"
                                    Tag="{x:Bind}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl
                                            VerticalAlignment="Center"
                                            Content="{x:Bind local:PostsManagerView.StatusText(IsPublished)}"
                                            Style="{x:Bind local:PostsManagerView.StatusStyle(IsPublished)}"
                                            Visibility="{x:Bind local:PostsManagerView.HasStatus(IsPublished)}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock Style="{StaticResource MzRowTitleTextStyle}" Text="{x:Bind Title}" />
                                            <TextBlock Style="{StaticResource MzMetaTextStyle}" Text="{x:Bind local:PostsManagerView.FormatSubtitle(RouteName, Categories)}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource MzCountTextStyle}"
                                            Text="{x:Bind local:PostsManagerView.FormatDate(PublishedDate, LastModifiedDate)}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>

                <Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Content="{xaml:Localize Key=LoadMore}"
                    Style="{StaticResource MzStandardButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ProgressRing
                    Margin="0,32"
                    IsActive="{x:Bind local:PostsManagerView.Any(ViewModel.IsLoading, ViewModel.IsLoadingMore), Mode=OneWay}"
                    Visibility="{x:Bind local:PostsManagerView.AnyVisible(ViewModel.IsLoading, ViewModel.IsLoadingMore), Mode=OneWay}" />

                <StackPanel Style="{StaticResource MzEmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="{StaticResource MzGlyphNews}" Style="{StaticResource MzEmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{xaml:Localize Key=NoPostsFound}" />
                </StackPanel>

                <StackPanel Style="{StaticResource MzEmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="{StaticResource MzGlyphWarning}" Style="{StaticResource MzEmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{xaml:Localize Key=CouldNotLoadData}" />
                    <TextBlock Style="{StaticResource MzEmptyStateBodyTextStyle}" Text="{xaml:Localize Key=AdminLoadErrorDescription}" />
                    <TextBlock
                        Style="{StaticResource MzMetaTextStyle}"
                        HorizontalAlignment="Center"
                        MaxWidth="560"
                        Text="{x:Bind ViewModel.ErrorDetail, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="{xaml:Localize Key=Retry}"
                        Style="{StaticResource MzStandardButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MzTypeScale">
                <VisualState x:Name="MzTypeScaleWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageTitle.Style" Value="{StaticResource MzTitleWideTextStyle}" />
                        <Setter Target="PageRoot.Padding" Value="{StaticResource MzPagePaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MzTypeScaleCompact" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:PostsManagerViewBase>
