<local:TagsManagerViewBase
    x:Class="MZikmund.Views.Admin.TagsManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MZikmund.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dto="using:MZikmund.DataContracts.Blog"
    xmlns:local="using:MZikmund.Views.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="using:MZikmund.Extensions.Xaml"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="{StaticResource MzPagePaddingCompact}">
            <StackPanel Style="{StaticResource MzPageContainerStackStyle}">
                <Grid Margin="0,0,0,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Name="PageTitle"
                            Style="{StaticResource MzTitleTextStyle}"
                            Text="{x:Bind ViewModel.Title}" />
                        <TextBlock Style="{StaticResource MzMetaTextStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="TagsAdd"
                        Command="{x:Bind ViewModel.AddTagCommand}"
                        Style="{StaticResource MzAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource MzIconFontFamily}"
                                FontSize="16"
                                Glyph="{StaticResource MzGlyphAdd}" />
                            <TextBlock Text="{xaml:Localize Key=AddTag}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox
                    MaxWidth="480"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="TagsSearch"
                    AutomationProperties.Name="{xaml:Localize Key=Search}"
                    PlaceholderText="{xaml:Localize Key=SearchTags}"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border
                    Padding="16"
                    Style="{StaticResource MzLayerSurfaceStyle}"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:MzWrapPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:Tag">
                                <Button
                                    Click="TagPill_Click"
                                    Content="{x:Bind DisplayName}"
                                    Style="{StaticResource MzTagPillButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind RouteName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ProgressRing
                    Margin="0,32"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Style="{StaticResource MzEmptyStatePanelStyle}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="{StaticResource MzGlyphWarning}" Style="{StaticResource MzEmptyStateIconStyle}" />
                    <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{xaml:Localize Key=CouldNotLoadData}" />
                    <TextBlock Style="{StaticResource MzEmptyStateBodyTextStyle}" Text="{xaml:Localize Key=AdminLoadErrorDescription}" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="{xaml:Localize Key=Retry}"
                        Style="{StaticResource MzStandardButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MzTypeScale">
                <VisualState x:Name="MzTypeScaleWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageTitle.Style" Value="{StaticResource MzTitleWideTextStyle}" />
                        <Setter Target="PageRoot.Padding" Value="{StaticResource MzPagePaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MzTypeScaleCompact" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:TagsManagerViewBase>
