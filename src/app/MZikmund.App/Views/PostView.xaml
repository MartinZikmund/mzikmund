<?xml version="1.0" encoding="utf-8" ?>
<local:PostViewBase
    x:Class="MZikmund.Views.PostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:MZikmund.Extensions.Xaml"
    xmlns:local="using:MZikmund.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="CommentsColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommentsLayout" CurrentStateChanged="CommentsLayout_CurrentStateChanged">
                <VisualState x:Name="Narrow" />
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommentsPanel.(Grid.Column)" Value="1" />
                        <Setter Target="CommentsPanel.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="CommentsPanel.Background" Value="{ThemeResource MzBgSecondaryBrush}" />
                        <Setter Target="CommentsPanel.BorderThickness" Value="1,0,0,0" />
                        <Setter Target="CommentsCloseRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid
            Grid.ColumnSpan="2"
            Padding="16,8"
            BorderBrush="{ThemeResource MzStrokeDividerBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource MzMetaTextStyle}"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                AutomationProperties.AutomationId="PostComments"
                AutomationProperties.Name="{extensions:Localize Key=Comments}"
                Command="{x:Bind ViewModel.ToggleCommentsCommand}"
                Style="{StaticResource MzSubtleButtonSmallStyle}"
                Visibility="{x:Bind ViewModel.Comments.IsPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource MzIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource MzGlyphComment}" />
                    <TextBlock Text="{x:Bind ViewModel.Comments.CountText, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="PostOpenInBrowser"
                Command="{x:Bind ViewModel.OpenInBrowserCommand}"
                Style="{StaticResource MzSubtleButtonSmallStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource MzIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource MzGlyphOpen}" />
                    <TextBlock Text="{extensions:Localize Key=OpenInBrowser}" />
                </StackPanel>
            </Button>
        </Grid>

        <ContentControl
            x:Name="WebViewContainer"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <ProgressRing
            Grid.Row="1"
            Width="48"
            Height="48"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Grid
            Grid.Row="1"
            Background="{ThemeResource MzBgBaseBrush}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Style="{StaticResource MzEmptyStatePanelStyle}">
                <FontIcon Glyph="{StaticResource MzGlyphWarning}" Style="{StaticResource MzEmptyStateIconStyle}" />
                <TextBlock Style="{StaticResource MzEmptyStateTitleTextStyle}" Text="{extensions:Localize Key=CouldNotLoadData}" />
                <TextBlock Style="{StaticResource MzEmptyStateBodyTextStyle}" Text="{extensions:Localize Key=ErrorLoadingData}" />
                <Button
                    HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.RetryCommand}"
                    Content="{extensions:Localize Key=Retry}"
                    Style="{StaticResource MzStandardButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="CommentsPanel"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Background="{ThemeResource MzBgBaseBrush}"
            BorderBrush="{ThemeResource MzStrokeDividerBrush}"
            Visibility="{x:Bind PanelVisibility(ViewModel.IsCommentsOpen, ViewModel.Comments.IsPanelVisible), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="CommentsCloseRow"
                Padding="16,4"
                BorderBrush="{ThemeResource MzStrokeDividerBrush}"
                BorderThickness="0,0,0,1">
                <Button
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="PostCommentsClose"
                    AutomationProperties.Name="{extensions:Localize Key=Close}"
                    Command="{x:Bind ViewModel.ToggleCommentsCommand}"
                    Style="{StaticResource MzSubtleButtonSmallStyle}"
                    ToolTipService.ToolTip="{extensions:Localize Key=Close}">
                    <FontIcon
                        FontFamily="{StaticResource MzIconFontFamily}"
                        FontSize="14"
                        Glyph="{StaticResource MzGlyphDismiss}" />
                </Button>
            </Grid>
            <local:CommentsView Grid.Row="1" ViewModel="{x:Bind ViewModel.Comments, Mode=OneWay}" />
        </Grid>
    </Grid>
</local:PostViewBase>
