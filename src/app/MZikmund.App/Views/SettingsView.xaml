<local:SettingsViewBase
    x:Class="MZikmund.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MZikmund.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:MZikmund.Extensions.Xaml"
    xmlns:local="using:MZikmund.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid x:Name="PageRoot" Padding="{StaticResource MzPagePaddingCompact}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="{StaticResource MzContainerNarrowWidth}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    x:Name="PageTitle"
                    Margin="0,0,0,8"
                    Style="{StaticResource MzTitleTextStyle}"
                    Text="{x:Bind ViewModel.Title}" />

                <TextBlock Style="{StaticResource MzSettingsSectionHeaderTextStyle}" Text="{extensions:Localize Key=Appearance}" />
                <controls:MzSettingsCard
                    Description="{extensions:Localize Key=ThemeDescription}"
                    Glyph="{StaticResource MzGlyphCircleHalfFill}"
                    Header="{extensions:Localize Key=Theme}">
                    <ComboBox
                        MinWidth="200"
                        AutomationProperties.AutomationId="SettingsTheme"
                        AutomationProperties.Name="{extensions:Localize Key=Theme}"
                        SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{extensions:Localize Key=ThemeSystem}" />
                        <ComboBoxItem Content="{extensions:Localize Key=ThemeLight}" />
                        <ComboBoxItem Content="{extensions:Localize Key=ThemeDark}" />
                    </ComboBox>
                </controls:MzSettingsCard>

                <TextBlock Style="{StaticResource MzSettingsSectionHeaderTextStyle}" Text="{extensions:Localize Key=Account}" />
                <controls:MzSettingsCard
                    Description="{x:Bind ViewModel.AccountDescription, Mode=OneWay}"
                    Glyph="{StaticResource MzGlyphPerson}"
                    Header="{extensions:Localize Key=Account}" />

                <TextBlock Style="{StaticResource MzSettingsSectionHeaderTextStyle}" Text="{extensions:Localize Key=About}" />
                <StackPanel Spacing="4">
                    <controls:MzSettingsCard
                        Description="{x:Bind ViewModel.Version}"
                        Glyph="{StaticResource MzGlyphInfo}"
                        Header="Martin Zikmund" />
                    <controls:MzSettingsCard Glyph="{StaticResource MzGlyphLink}" Header="{extensions:Localize Key=Website}">
                        <Button
                            AutomationProperties.AutomationId="SettingsWebsite"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://mzikmund.dev"
                            Content="mzikmund.dev"
                            Style="{StaticResource MzStandardButtonSmallStyle}" />
                    </controls:MzSettingsCard>
                    <controls:MzSettingsCard Glyph="{StaticResource MzGlyphRss}" Header="{extensions:Localize Key=RssFeed}">
                        <Button
                            AutomationProperties.AutomationId="SettingsRss"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://mzikmund.dev/rss"
                            Content="RSS"
                            Style="{StaticResource MzStandardButtonSmallStyle}" />
                    </controls:MzSettingsCard>
                    <controls:MzSettingsCard Glyph="{StaticResource MzGlyphOpen}" Header="{extensions:Localize Key=SourceCode}">
                        <Button
                            AutomationProperties.AutomationId="SettingsSource"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://github.com/MartinZikmund/mzikmund"
                            Content="GitHub"
                            Style="{StaticResource MzStandardButtonSmallStyle}" />
                    </controls:MzSettingsCard>
                    <controls:MzSettingsCard Glyph="{StaticResource MzGlyphShield}" Header="{extensions:Localize Key=PrivacyPolicy}">
                        <Button
                            AutomationProperties.AutomationId="SettingsPrivacy"
                            Command="{x:Bind ViewModel.OpenLinkCommand}"
                            CommandParameter="https://mzikmund.dev/privacy"
                            Content="mzikmund.dev/privacy"
                            Style="{StaticResource MzStandardButtonSmallStyle}" />
                    </controls:MzSettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="MzTypeScale">
                <VisualState x:Name="MzTypeScaleWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageTitle.Style" Value="{StaticResource MzTitleWideTextStyle}" />
                        <Setter Target="PageRoot.Padding" Value="{StaticResource MzPagePaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MzTypeScaleCompact" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</local:SettingsViewBase>
