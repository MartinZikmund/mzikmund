<dialogs:StatusMessageDialogBase
    x:Class="MZikmund.Dialogs.StatusMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:MZikmund.Dialogs"
    xmlns:models="using:MZikmund.Models.Dialogs"
    xmlns:xaml="using:MZikmund.Extensions.Xaml"
    Title="{x:Bind ViewModel.Title}"
    PrimaryButtonText="{xaml:Localize Key=Ok}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid VerticalAlignment="Top">
            <FontIcon
                FontFamily="{StaticResource MzIconFontFamily}"
                FontSize="28"
                Foreground="{ThemeResource MzAccentTextBrush}"
                Glyph="{StaticResource MzGlyphInfo}"
                Visibility="{x:Bind dialogs:StatusMessageDialog.IsType(ViewModel.DialogType, models:StatusMessageDialogType.Information)}" />
            <FontIcon
                FontFamily="{StaticResource MzIconFontFamily}"
                FontSize="28"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="{StaticResource MzGlyphWarning}"
                Visibility="{x:Bind dialogs:StatusMessageDialog.IsType(ViewModel.DialogType, models:StatusMessageDialogType.Warning)}" />
            <FontIcon
                FontFamily="{StaticResource MzIconFontFamily}"
                FontSize="28"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="{StaticResource MzGlyphError}"
                Visibility="{x:Bind dialogs:StatusMessageDialog.IsType(ViewModel.DialogType, models:StatusMessageDialogType.Error)}" />
        </Grid>
        <ScrollViewer
            Grid.Column="1"
            MaxHeight="180"
            Padding="0,0,12,0">
            <TextBlock
                IsTextSelectionEnabled="True"
                Text="{x:Bind ViewModel.Text}"
                TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</dialogs:StatusMessageDialogBase>
