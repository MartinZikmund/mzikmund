<Page
    x:Class="MZikmund.App.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:MZikmund.Extensions.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:uub="using:Uno.UI.Behaviors"
    x:Name="ShellRoot"
    Background="{ThemeResource MzBgBaseBrush}"
    mc:Ignorable="d">

    <Grid uub:VisibleBoundsPadding.PaddingMask="All">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarGrid"
            Height="48"
            Padding="16,0,0,0"
            ColumnSpacing="12"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/NavigationViewLogo.png" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource MzCaptionTextStyle}"
                Text="{x:Bind ViewModel.Title}" />
        </Grid>

        <mux:NavigationView
            x:Name="AppNavigation"
            Grid.Row="1"
            AutomationProperties.AutomationId="AppNavigation"
            BackRequested="AppNavigation_BackRequested"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="AppNavigation_ItemInvoked"
            PaneDisplayMode="LeftMinimal"
            PaneTitle="Martin Zikmund">
            <mux:NavigationView.MenuItems>
                <mux:NavigationViewItem
                    x:Name="HomeNavigationViewItem"
                    AutomationProperties.AutomationId="NavHome"
                    Content="{extensions:Localize Key=Home}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphHome}"
                    Tag="Home" />
                <mux:NavigationViewItem
                    x:Name="BlogNavigationViewItem"
                    AutomationProperties.AutomationId="NavBlog"
                    Content="{extensions:Localize Key=Blog}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphNews}"
                    Tag="Blog" />
                <mux:NavigationViewItem
                    AutomationProperties.AutomationId="NavVideos"
                    Content="{extensions:Localize Key=Videos}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphVideoClip}"
                    Tag="Videos" />
                <mux:NavigationViewItem
                    AutomationProperties.AutomationId="NavContact"
                    Content="{extensions:Localize Key=Contact}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphMail}"
                    Tag="Contact" />
                <mux:NavigationViewItem
                    AutomationProperties.AutomationId="NavAdmin"
                    Content="{extensions:Localize Key=Admin}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphShield}"
                    SelectsOnInvoked="False"
                    Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <mux:NavigationViewItem.MenuItems>
                        <mux:NavigationViewItem
                            AutomationProperties.AutomationId="NavAdminPosts"
                            Content="{extensions:Localize Key=Posts}"
                            Icon="{extensions:MzFontIcon GlyphKey=MzGlyphNews}"
                            Tag="PostsManager" />
                        <mux:NavigationViewItem
                            AutomationProperties.AutomationId="NavAdminMedia"
                            Content="{extensions:Localize Key=Media}"
                            Icon="{extensions:MzFontIcon GlyphKey=MzGlyphImageMultiple}"
                            Tag="MediaBrowser" />
                        <mux:NavigationViewItem
                            AutomationProperties.AutomationId="NavAdminTags"
                            Content="{extensions:Localize Key=Tags}"
                            Icon="{extensions:MzFontIcon GlyphKey=MzGlyphTag}"
                            Tag="TagsManager" />
                        <mux:NavigationViewItem
                            AutomationProperties.AutomationId="NavAdminCategories"
                            Content="{extensions:Localize Key=Categories}"
                            Icon="{extensions:MzFontIcon GlyphKey=MzGlyphFolder}"
                            Tag="CategoriesManager" />
                    </mux:NavigationViewItem.MenuItems>
                </mux:NavigationViewItem>
            </mux:NavigationView.MenuItems>
            <mux:NavigationView.FooterMenuItems>
                <mux:NavigationViewItem
                    AutomationProperties.AutomationId="NavLogin"
                    Content="{extensions:Localize Key=Login}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphPerson}"
                    SelectsOnInvoked="False"
                    Tag="Login"
                    Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <mux:NavigationViewItem
                    AutomationProperties.AutomationId="NavLogout"
                    Content="{extensions:Localize Key=Logout}"
                    Icon="{extensions:MzFontIcon GlyphKey=MzGlyphSignOut}"
                    SelectsOnInvoked="False"
                    Tag="Logout"
                    ToolTipService.ToolTip="{x:Bind ViewModel.UserName, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </mux:NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="InnerFrame" Navigated="InnerFrame_Navigated" />
                <StackPanel
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <mux:ProgressBar IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock
                        Margin="16,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MzMetaTextStyle}"
                        Text="{x:Bind ViewModel.LoadingStatusMessage, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </mux:NavigationView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppNavigation.PaneDisplayMode" Value="Top" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
