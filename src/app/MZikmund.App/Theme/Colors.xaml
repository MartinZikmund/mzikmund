			<SolidColorBrush x:Key="MzAccentTextBrush" Color="#FF005A9E" />
			<SolidColorBrush x:Key="MzAccentFillBrush" Color="#FF005A9E" />
			<SolidColorBrush x:Key="MzAccentFillHoverBrush" Color="#FF004275" />
