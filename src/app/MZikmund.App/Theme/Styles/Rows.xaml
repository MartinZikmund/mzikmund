<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  The web's taxonomy row: a 44px list row inside one Layer surface, with the vertical accent bar on hover.  -->
	<Style x:Key="MzListRowButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource MzTextPrimaryBrush}" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="MinHeight" Value="44" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="{StaticResource MzControlCornerRadius}" />
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="RowRoot" Background="Transparent">
						<Border
							x:Name="RowFill"
							Background="{TemplateBinding Background}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<Border
							x:Name="IndicatorBar"
							Width="3"
							Height="16"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							Background="{ThemeResource MzAccentFillBrush}"
							CornerRadius="2"
							Opacity="0"
							RenderTransformOrigin="0.5,0.5">
							<Border.RenderTransform>
								<CompositeTransform x:Name="IndicatorTransform" ScaleY="0" />
							</Border.RenderTransform>
						</Border>
						<ContentPresenter
							x:Name="RowContent"
							Padding="{TemplateBinding Padding}"
							HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Foreground="{TemplateBinding Foreground}" />
						<Border
							x:Name="FocusRing"
							BorderBrush="{ThemeResource MzStrokeFocusBrush}"
							BorderThickness="2"
							CornerRadius="{TemplateBinding CornerRadius}"
							IsHitTestVisible="False"
							Visibility="Collapsed" />

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzShimmerBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimation
											Storyboard.TargetName="IndicatorBar"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0:0:0.167" />
										<DoubleAnimationUsingKeyFrames Storyboard.TargetName="IndicatorTransform" Storyboard.TargetProperty="ScaleY">
											<SplineDoubleKeyFrame
												KeySpline="0,0 0,1"
												KeyTime="0:0:0.25"
												Value="1" />
										</DoubleAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzAccentSubtleBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimation
											Storyboard.TargetName="IndicatorBar"
											Storyboard.TargetProperty="Opacity"
											To="1"
											Duration="0" />
										<DoubleAnimation
											Storyboard.TargetName="IndicatorTransform"
											Storyboard.TargetProperty="ScaleY"
											To="0.6"
											Duration="0" />
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="RowContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextDisabledBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="FocusRing.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
								<VisualState x:Name="Unfocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  The web's .tag: transparent pill, strong stroke, secondary label; border and label pick up the accent on hover.  -->
	<Style x:Key="MzTagPillButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource MzTextSecondaryBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource MzStrokeControlStrongBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="12,4" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="CornerRadius" Value="{StaticResource MzPillCornerRadius}" />
		<Setter Property="FontFamily" Value="{StaticResource MzFontFamilyMedium}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid>
						<Border
							x:Name="PillBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<ContentPresenter
							x:Name="PillContent"
							Padding="{TemplateBinding Padding}"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Foreground="{TemplateBinding Foreground}" />
						<Border
							x:Name="FocusRing"
							Margin="-3"
							BorderBrush="{ThemeResource MzStrokeFocusBrush}"
							BorderThickness="2"
							CornerRadius="17"
							IsHitTestVisible="False"
							Visibility="Collapsed" />

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="PillBorder.BorderBrush" Value="{ThemeResource MzAccentTextBrush}" />
										<Setter Target="PillBorder.Background" Value="{ThemeResource MzAccentSubtleBrush}" />
										<Setter Target="PillContent.Foreground" Value="{ThemeResource MzAccentTextBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="PillBorder.BorderBrush" Value="{ThemeResource MzAccentTextBrush}" />
										<Setter Target="PillBorder.Background" Value="{ThemeResource MzAccentSubtleStrongBrush}" />
										<Setter Target="PillContent.Foreground" Value="{ThemeResource MzAccentTextBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="PillContent.Foreground" Value="{ThemeResource MzTextDisabledBrush}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<VisualState.Setters>
										<Setter Target="FocusRing.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
								<VisualState x:Name="Unfocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Right-aligned count that forms a scannable column.  -->
	<Style x:Key="MzCountTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MzMetaTextStyle}">
		<Setter Property="HorizontalAlignment" Value="Right" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextAlignment" Value="Right" />
	</Style>

	<Style x:Key="MzRowTitleTextStyle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="{StaticResource MzFontFamilyMedium}" />
		<Setter Property="FontSize" Value="15" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Foreground" Value="{ThemeResource MzTextPrimaryBrush}" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style x:Key="MzRowIconStyle" TargetType="FontIcon">
		<Setter Property="FontFamily" Value="{StaticResource MzIconFontFamily}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="Foreground" Value="{ThemeResource MzTextSecondaryBrush}" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<!--  Thin separators between rows inside a Layer surface.  -->
	<Style x:Key="MzRowDividerStyle" TargetType="Border">
		<Setter Property="Height" Value="1" />
		<Setter Property="Margin" Value="16,0" />
		<Setter Property="Background" Value="{ThemeResource MzStrokeDividerBrush}" />
	</Style>

</ResourceDictionary>
