	<!--  Corrected from the brief: a plain two-Setter BasedOn="{StaticResource MzSubtleButtonStyle}"
	      (no Template override) would inherit Subtle's ControlTemplate as-is, whose PointerOver/Pressed
	      Storyboards hard-code ButtonFill.Background to MzShimmerBrush and, on Pressed, ButtonContent's
	      Foreground to MzTextSecondaryBrush — those values are baked into the template's Storyboards,
	      not bound back to this Style's Background/Foreground Setters. The result would be a gray
	      "read more" button that ignores its own accent tint on hover/press. _controls.scss's
	      accent-subtle button hover swaps to mz-accent-subtle-strong and never changes the text color,
	      so this variant needs its own template with that hover fill and a foreground that stays
	      MzAccentTextBrush throughout (Pressed reuses the hover fill, matching :hover and :active
	      applying together on a pointer device, since the site defines no separate :active rule).  -->
	<Style x:Key="MzAccentSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource MzSubtleButtonStyle}">
		<Setter Property="Background" Value="{ThemeResource MzAccentSubtleBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource MzAccentTextBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="ButtonRoot">
						<Grid.RenderTransform>
							<CompositeTransform x:Name="ButtonTransform" />
						</Grid.RenderTransform>
						<Border
							x:Name="ButtonFill"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<ContentPresenter
							x:Name="ButtonContent"
							Padding="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Foreground="{TemplateBinding Foreground}" />
						<Border
							x:Name="FocusRing"
							Margin="-3"
							BorderBrush="{ThemeResource MzStrokeFocusBrush}"
							BorderThickness="2"
							CornerRadius="7"
							IsHitTestVisible="False"
							Visibility="Collapsed">
							<Border BorderBrush="{ThemeResource MzStrokeFocusInnerBrush}" BorderThickness="1" CornerRadius="5" />
						</Border>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzAccentSubtleStrongBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzAccentSubtleStrongBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimation
											Storyboard.TargetName="ButtonTransform"
											Storyboard.TargetProperty="TranslateY"
											To="1"
											Duration="0" />
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzCardSecondaryBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextDisabledBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility">
											<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
								<VisualState x:Name="Unfocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Size variants only restate Padding/MinHeight/FontSize — FontFamily and FontWeight stay
	      whatever the BasedOn chain already set on the base style, so they're never touched in
	      isolation.  -->
	<Style x:Key="MzStandardButtonSmallStyle" TargetType="Button" BasedOn="{StaticResource MzStandardButtonStyle}">
		<Setter Property="Padding" Value="{StaticResource MzButtonSmallPadding}" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<Style x:Key="MzStandardButtonLargeStyle" TargetType="Button" BasedOn="{StaticResource MzStandardButtonStyle}">
		<Setter Property="Padding" Value="{StaticResource MzButtonLargePadding}" />
		<Setter Property="MinHeight" Value="44" />
