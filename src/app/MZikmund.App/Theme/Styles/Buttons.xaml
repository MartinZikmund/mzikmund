<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  Fluent presses a control down rather than scaling it: TranslateY = 1 at 0ms. Duration is a
	      literal "0", not {StaticResource MzDurationInstant} — that resource is typed as x:String
	      (unlike MzButtonPadding/MzControlCornerRadius, which are typed Thickness/CornerRadius), and
	      WinUI's independent-animation fast path requires a literal Duration="0" on the animation
	      itself (see "Dependent and independent animations"); routing it through a StaticResource
	      string risks both a failed type conversion and losing that fast path. ObjectAnimationUsingKeyFrames
	      is unconditionally independent regardless of duration, so the brush swaps below need no
	      EnableDependentAnimation — only true for genuinely dependent Double/Color animations on
	      non-GPU properties (Width, Height, Margin), which none of these are.  -->

	<Style x:Key="MzStandardButtonStyle" TargetType="Button">
		<Setter Property="Background" Value="{ThemeResource MzCardBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource MzTextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource MzControlElevationBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{StaticResource MzControlCornerRadius}" />
		<Setter Property="Padding" Value="{StaticResource MzButtonPadding}" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="FontFamily" Value="{StaticResource MzFontFamilySemiBold}" />
		<Setter Property="FontSize" Value="17" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="ButtonRoot">
						<Grid.RenderTransform>
							<CompositeTransform x:Name="ButtonTransform" />
						</Grid.RenderTransform>
						<Border
							x:Name="ButtonFill"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<ContentPresenter
							x:Name="ButtonContent"
							Padding="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Foreground="{TemplateBinding Foreground}" />
						<Border
							x:Name="FocusRing"
							Margin="-3"
							BorderBrush="{ThemeResource MzStrokeFocusBrush}"
							BorderThickness="2"
							CornerRadius="7"
							IsHitTestVisible="False"
							Visibility="Collapsed">
							<Border BorderBrush="{ThemeResource MzStrokeFocusInnerBrush}" BorderThickness="1" CornerRadius="5" />
						</Border>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzBgSecondaryBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzBgSecondaryBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="BorderBrush">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzStrokeControlBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextSecondaryBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimation
											Storyboard.TargetName="ButtonTransform"
											Storyboard.TargetProperty="TranslateY"
											To="1"
											Duration="0" />
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzCardSecondaryBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextDisabledBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility">
											<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
								<VisualState x:Name="Unfocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Reproduces Fluent's ControlElevationBorderBrush by reusing MzAccentControlElevationBorderBrush
	      (Colors.xaml) as-is: it already encodes the website's box-shadow pair — inset 0 -1px black14%
	      on the bottom, inset 0 1px white8% on top — as a single vertical LinearGradientBrush. Press
	      removes it by swapping BorderBrush to the flat active fill, which is this style's translation
	      of the website's ":active { box-shadow: none; }".
	      Dark-theme hover/pressed flips the foreground to black: white on the dark theme's hover/active
	      fills is 2.96:1 / fails AA. MzTextOnAccentPressedBrush is white in Light and black in Dark, so
	      this one brush swap is theme-correct without an explicit theme check.  -->
	<Style x:Key="MzAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource MzStandardButtonStyle}">
		<Setter Property="Background" Value="{ThemeResource MzAccentFillBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource MzTextOnAccentBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource MzAccentControlElevationBorderBrush}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="Button">
					<Grid x:Name="ButtonRoot">
						<Grid.RenderTransform>
							<CompositeTransform x:Name="ButtonTransform" />
						</Grid.RenderTransform>
						<Border
							x:Name="ButtonFill"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}" />
						<ContentPresenter
							x:Name="ButtonContent"
							Padding="{TemplateBinding Padding}"
							HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							Content="{TemplateBinding Content}"
							ContentTemplate="{TemplateBinding ContentTemplate}"
							Foreground="{TemplateBinding Foreground}" />
						<Border
							x:Name="FocusRing"
							Margin="-3"
							BorderBrush="{ThemeResource MzStrokeFocusBrush}"
							BorderThickness="2"
							CornerRadius="7"
							IsHitTestVisible="False"
							Visibility="Collapsed">
							<Border BorderBrush="{ThemeResource MzStrokeFocusInnerBrush}" BorderThickness="1" CornerRadius="5" />
						</Border>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzAccentFillHoverBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextOnAccentPressedBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Pressed">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzAccentFillActiveBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="BorderBrush">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzAccentFillActiveBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextOnAccentPressedBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<DoubleAnimation
											Storyboard.TargetName="ButtonTransform"
											Storyboard.TargetProperty="TranslateY"
											To="1"
											Duration="0" />
									</Storyboard>
								</VisualState>
								<VisualState x:Name="Disabled">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonFill" Storyboard.TargetProperty="Background">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzCardSecondaryBrush}" />
										</ObjectAnimationUsingKeyFrames>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="Foreground">
											<DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource MzTextDisabledBrush}" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
							</VisualStateGroup>
							<VisualStateGroup x:Name="FocusStates">
								<VisualState x:Name="Focused">
									<Storyboard>
										<ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Visibility">
											<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
										</ObjectAnimationUsingKeyFrames>
									</Storyboard>
								</VisualState>
								<VisualState x:Name="PointerFocused" />
								<VisualState x:Name="Unfocused" />
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

