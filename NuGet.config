<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned to nuget.org only so local restore matches CI exactly.
    Without this, machine-level feeds leak in: Uno.Sdk 6.7.7 appears to be a
    stable release locally but only exists on the private "Uno Internal" feed,
    and CI would fail on it.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
